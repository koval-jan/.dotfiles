#
#  difftastic as diff tool (difftool mode)
#  - `git diff` = standardny unified format (parsovatelny pre agentov/TUI)
#  - `git dft`  = difftastic (bohaty view)
#  - `git dlog` = difftastic log -p
#

[difftool]
	prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  difftool = true

[alias]
  dft = difftool --tool=difftastic
  dlog = "-c diff.external=difft log -p --ext-diff"
